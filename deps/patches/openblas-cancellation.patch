+#include <stdlib.h>
+#include "common.h"
+
+/* Cooperative cancellation of in-flight OpenBLAS operations.
+ *
+ * A cancellation token is bound to the calling ("user") thread via
+ * thread-local storage.  Long-running compute drivers poll the token at
+ * block granularity and bail out early once the token has been cancelled
+ * (from any thread).  A cancelled operation returns quickly but leaves its
+ * output buffers in an unspecified, partially-updated state; the caller is
+ * responsible for discarding the result.  The library itself remains in a
+ * consistent state and can service further calls, including from the same
+ * thread with the same (reset) or another token.
+ *
+ * These symbols are deliberately exported without any SYMBOLPREFIX /
+ * SYMBOLSUFFIX decoration, like the other openblas_* utility functions
+ * that are not per-precision entry points.
+ */
+
+struct openblas_cancel_token {
+  volatile int cancelled;
+};
+
+#if defined(_MSC_VER) && !defined(__clang__)
+#define OPENBLAS_CANCEL_TLS __declspec(thread)
+#else
+#define OPENBLAS_CANCEL_TLS __thread
+#endif
+
+/* Token bound to the current thread, if any.  BLAS worker threads never
+ * have a binding of their own; the level-3 thread driver forwards the
+ * binding of the thread that issued the operation through the job
+ * arguments (blas_arg_t.cancel_token). */
+static OPENBLAS_CANCEL_TLS openblas_cancel_token_t *openblas_cancel_bound = NULL;
+
+#if defined(__GNUC__) || defined(__clang__)
+#define OPENBLAS_CANCEL_LOAD(PTR)       __atomic_load_n((PTR), __ATOMIC_RELAXED)
+#define OPENBLAS_CANCEL_STORE(PTR, VAL) __atomic_store_n((PTR), (VAL), __ATOMIC_RELEASE)
+#else
+#define OPENBLAS_CANCEL_LOAD(PTR)       (*(PTR))
+#define OPENBLAS_CANCEL_STORE(PTR, VAL) do { WMB; *(PTR) = (VAL); } while (0)
+#endif
+
+/* Allocate a fresh, un-cancelled token. */
+openblas_cancel_token_t *openblas_cancel_token_new(void) {
+  openblas_cancel_token_t *token = (openblas_cancel_token_t *)malloc(sizeof(*token));
+  if (token != NULL) token->cancelled = 0;
+  return token;
+}
+
+/* Free a token.  The token must not be bound to any thread nor observable
+ * by any in-flight operation anymore. */
+void openblas_cancel_token_free(openblas_cancel_token_t *token) {
+  free(token);
+}
+
+/* Bind TOKEN to the calling thread; subsequent BLAS calls made by this
+ * thread observe it.  The binding is sticky: it stays in effect for this
+ * thread until replaced by another call.  Passing NULL unbinds. */
+void openblas_cancel_token_bind(openblas_cancel_token_t *token) {
+  openblas_cancel_bound = token;
+}
+
+/* Mark TOKEN as cancelled.  May be called from any thread. */
+void openblas_cancel(openblas_cancel_token_t *token) {
+  if (token == NULL) return;
+  OPENBLAS_CANCEL_STORE(&token->cancelled, 1);
+}
+
+/* Clear the cancelled flag so the token can be reused.  Only do this while
+ * no operation observing the token is in flight. */
+void openblas_cancel_reset(openblas_cancel_token_t *token) {
+  if (token == NULL) return;
+  OPENBLAS_CANCEL_STORE(&token->cancelled, 0);
+}
+
+/* Return nonzero iff TOKEN has been cancelled. */
+int openblas_cancel_token_cancelled(openblas_cancel_token_t *token) {
+  if (token == NULL) return 0;
+  return OPENBLAS_CANCEL_LOAD(&token->cancelled) != 0;
+}
+
+/* --- internal helpers (not part of the public API) --------------------- */
+
+/* Token bound to the calling thread, or NULL. */
+openblas_cancel_token_t *openblas_cancel_get_bound(void) {
+  return openblas_cancel_bound;
+}
+
+/* Cheap poll usable from compute drivers; TOKEN may be NULL. */
+int openblas_cancel_poll(openblas_cancel_token_t *token) {
+  if (token == NULL) return 0;
+  return OPENBLAS_CANCEL_LOAD(&token->cancelled) != 0;
+}
+
+/* Poll the calling thread's own binding. */
+int openblas_cancel_poll_bound(void) {
+  return openblas_cancel_poll(openblas_cancel_bound);
+}
