+/* Cooperative cancellation of in-flight operations.
+ *
+ * Bind a token to the calling thread with openblas_cancel_token_bind();
+ * the binding is sticky and applies to all subsequent calls made by that
+ * thread until it is replaced (bind NULL to unbind).  Cancelling the token
+ * from any other thread with openblas_cancel() makes supported compute
+ * drivers (currently the level-3 GEMM drivers) return early.  A cancelled
+ * operation leaves its output in an unspecified, partially-updated state;
+ * the caller must discard the result.  The library itself stays consistent
+ * and can service further calls.  Reset the flag with
+ * openblas_cancel_reset() to reuse a token.  These symbols are exported
+ * without any symbol prefix/suffix decoration. */
+#ifndef OPENBLAS_CANCEL_TOKEN_DEFINED
+#define OPENBLAS_CANCEL_TOKEN_DEFINED
+typedef struct openblas_cancel_token openblas_cancel_token_t;
+#endif
+openblas_cancel_token_t *openblas_cancel_token_new(void);
+void openblas_cancel_token_free(openblas_cancel_token_t *token);
+void openblas_cancel_token_bind(openblas_cancel_token_t *token);
+void openblas_cancel(openblas_cancel_token_t *token);
+void openblas_cancel_reset(openblas_cancel_token_t *token);
+int openblas_cancel_token_cancelled(openblas_cancel_token_t *token);
