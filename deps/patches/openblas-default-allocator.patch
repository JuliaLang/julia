+#define MEMORY_TLS __declspec(thread)
+#elif defined(__clang__)
+#if __has_feature(tls)
+#define MEMORY_TLS __thread
+#endif
+#elif defined(__GNUC__) || defined(__SUNPRO_C) || defined(__xlC__)
+#define MEMORY_TLS __thread
+#endif
+#ifdef MEMORY_TLS
